[Unit]
Description=vHackintosh shared Wayland display for VM windows
After=local-fs.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vhackintosh/web/current
Environment=PYTHONPATH=/opt/vhackintosh/web/current/vendor
Environment=VHACKINTOSH_VM_CATALOG=/root/.config/vhackintosh/vms.json
Environment=VHACKINTOSH_CONFIG_DIR=/root/.config/vhackintosh
Environment=VHACKINTOSH_REIMS_REGISTRY=/root/.config/reims-ctl/vms.toml
Environment=XDG_CONFIG_HOME=/root/.config
Environment=XDG_DATA_HOME=/root/.local/share
Environment=CARGO_HOME=/root/.cargo
Environment=XDG_RUNTIME_DIR=/run/vhackintosh-display
Environment=WAYLAND_DISPLAY=wayland-0
RuntimeDirectory=vhackintosh-display
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/openvt --switch --wait -- /usr/local/bin/vhackintosh-waysession /usr/bin/python3 -m core.display_session_guard
ExecStartPost=/usr/bin/bash /usr/local/bin/vhackintosh-wait-wayland
KillMode=control-group
TimeoutStartSec=120s
TimeoutStopSec=15s
UMask=0077
StandardOutput=journal
StandardError=journal
