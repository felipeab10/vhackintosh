[Unit]
Description=vHackintosh shared Wayland display for VM windows
After=local-fs.target seatd.service getty@tty2.service
Requires=seatd.service
# O systemd controla o VT gráfico diretamente. O login automático não pode
# ocupar o mesmo terminal enquanto o compositor compartilhado estiver ativo.
Conflicts=getty@tty2.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vhackintosh/web/current
Environment=PYTHONPATH=/opt/vhackintosh/web/current/vendor
Environment=VHACKINTOSH_VM_CATALOG=/root/.config/vhackintosh/vms.json
Environment=VHACKINTOSH_CONFIG_DIR=/root/.config/vhackintosh
Environment=VHACKINTOSH_REIMS_REGISTRY=/root/.config/reims-ctl/vms.toml
Environment=XDG_CONFIG_HOME=/root/.config
Environment=XDG_DATA_HOME=/root/.local/share
Environment=CARGO_HOME=/root/.cargo
Environment=XDG_RUNTIME_DIR=/run/vhackintosh-display
# Sway é o compositor raiz desta sessão. Não herde WAYLAND_DISPLAY nem inicie um compositor aninhado: isso faria o wlroots selecionar o backend Wayland em vez da GPU física via DRM. O nome do socket criado pelo Sway é publicado pelo cliente.
Environment=WLR_BACKENDS=drm,libinput
RuntimeDirectory=vhackintosh-display
RuntimeDirectoryMode=0700
TTYPath=/dev/tty2
StandardInput=tty-force
TTYReset=yes
TTYVTDisallocate=no
ExecStartPre=/usr/bin/chvt 2
ExecStart=/usr/local/bin/vhackintosh-waysession /usr/bin/python3 -m core.display_session_guard
ExecStartPost=/usr/bin/bash /usr/local/bin/vhackintosh-wait-wayland
ExecStopPost=-/usr/bin/chvt 1
KillMode=control-group
TimeoutStartSec=120s
TimeoutStopSec=15s
UMask=0077
StandardOutput=journal
StandardError=journal
