[Unit]
Description=vHackintosh privileged local management agent
After=local-fs.target systemd-sysusers.service systemd-tmpfiles-setup.service
RequiresMountsFor=/root/.config/vhackintosh /var/lib/vhackintosh

[Service]
Type=simple
User=root
Group=vhackintosh-web
WorkingDirectory=/opt/vhackintosh/web/current
Environment=PYTHONPATH=/opt/vhackintosh/web/current/vendor
Environment=VHACKINTOSH_VM_CATALOG=/root/.config/vhackintosh/vms.json
Environment=VHACKINTOSH_CONFIG_DIR=/root/.config/vhackintosh
Environment=VHACKINTOSH_REIMS_REGISTRY=/root/.config/reims-ctl/vms.toml
Environment=XDG_CONFIG_HOME=/root/.config
Environment=XDG_DATA_HOME=/root/.local/share
Environment=CARGO_HOME=/root/.cargo
Environment=VHACKINTOSH_VM_SUPERVISOR_STATUS=1
Environment=VHACKINTOSH_AGENT_SOCKET=/run/vhackintosh-agent/agent.sock
Environment=VHACKINTOSH_WEB_GROUP=vhackintosh-web
Environment=VHACKINTOSH_WEB_TRANSFER_DIR=/var/lib/vhackintosh/web/transfers
RuntimeDirectory=vhackintosh-agent
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 -m core.web_agent
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
