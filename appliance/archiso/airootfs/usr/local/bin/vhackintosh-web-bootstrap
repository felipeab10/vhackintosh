#!/usr/bin/python3
"""Create the first administrator account and announce its one-time credentials."""

from __future__ import annotations

import argparse
import os
import pwd
import sqlite3
import stat
import sys
from pathlib import Path


def _print_local_console(console_path: Path, text: str) -> bool:
    try:
        descriptor = os.open(console_path, os.O_WRONLY | getattr(os, "O_NOCTTY", 0))
    except OSError:
        return False
    try:
        if not stat.S_ISCHR(os.fstat(descriptor).st_mode) or not os.isatty(descriptor):
            return False
        os.write(descriptor, text.encode("utf-8", errors="replace"))
        return True
    except OSError:
        return False
    finally:
        os.close(descriptor)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--database", default="/var/lib/vhackintosh/web/auth.sqlite")
    parser.add_argument("--code-file", default="/run/vhackintosh-web/bootstrap-code")
    parser.add_argument("--console", default="/dev/console")
    parser.add_argument("--web-user", default="vhackintosh-web")
    args = parser.parse_args(argv)
    code_file = Path(args.code_file)
    try:
        # Invalidate codes left behind by older appliance builds. First-admin
        # creation is now restricted to the local console helper.
        code_file.unlink(missing_ok=True)
    except OSError as exc:
        print(f"Falha ao limpar código antigo de configuração do painel: {exc}", file=sys.stderr)
        return 1

    root = Path.cwd()
    if (root / "vendor").is_dir():
        sys.path.insert(0, str(root / "vendor"))
    sys.path.insert(0, str(root))
    try:
        from web.api.app import SQLiteAuthStore

        store = SQLiteAuthStore(args.database)
        created = store.ensure_default_admin()
        if created and os.geteuid() == 0:
            try:
                account = pwd.getpwnam(args.web_user)
                database = Path(args.database)
                os.chown(database, account.pw_uid, account.pw_gid)
                database.chmod(0o600)
                for suffix in ("-wal", "-shm"):
                    sidecar = Path(f"{database}{suffix}")
                    if sidecar.exists():
                        os.chown(sidecar, account.pw_uid, account.pw_gid)
                        sidecar.chmod(0o600)
            except KeyError:
                # Host-side tests and development environments may omit the service account.
                pass
    except (ImportError, OSError, RuntimeError, ValueError, sqlite3.Error) as exc:
        print(f"Falha ao preparar a conta administrativa inicial: {exc}", file=sys.stderr)
        return 1
    if not created:
        return 0

    message = (
        "\n\033[96m[vHackintosh] Conta inicial do painel criada:\033[0m\n"
        "  Usuário: admin\n"
        "  Senha provisória: vhackintosh\n"
        "  No primeiro acesso, será obrigatório definir uma nova senha.\n\n"
    )
    if not _print_local_console(Path(args.console), message):
        print("Conta inicial criada; o painel exigirá a troca da senha no primeiro acesso.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
