#!/usr/bin/env bash
# ==============================================================================
# vHackintosh Appliance - Global Launcher
# ==============================================================================

export PYTHONUNBUFFERED=1
# Sem FORCE_X11: a sessão gráfica do appliance é Wayland (sway kiosk). Exportar
# FORCE_X11/USE_X11 faria o harness do reims-vgpu (vm/boot-x86.sh) desfazer o
# WAYLAND_DISPLAY herdado, forçar WINIT_UNIX_BACKEND=x11 e apontar DISPLAY=:1 —
# endereço onde não há servidor X algum, já que não instalamos Xorg nem
# XWayland. O resultado seria uma janela que nunca aparece.

# Ajusta caminhos padrão
if [ -d "/opt/vhackintosh" ]; then
    export PYTHONPATH="/opt/vhackintosh:${PYTHONPATH:-}"
    exec /opt/vhackintosh/bin/vhackintosh "$@"
elif [ -d "$HOME/vhackintosh" ]; then
    export PYTHONPATH="$HOME/vhackintosh:${PYTHONPATH:-}"
    exec "$HOME/vhackintosh/bin/vhackintosh" "$@"
else
    echo "Erro: vHackintosh não encontrado em /opt/vhackintosh ou $HOME/vhackintosh"
    exit 1
fi
