#!/usr/bin/env python3
"""
vHackintosh OS — Copiador de Sistema com Barra de Progresso Visual Rich
Substitui o rsync verboso por uma barra elegante com porcentagem, velocidade e tempo restante.
"""

import sys
import re
import os
import subprocess
from rich.console import Console
from rich.progress import Progress, SpinnerColumn, BarColumn, TextColumn

console = Console()

_PROGRESS_RE = re.compile(
    r"\b(?P<percent>\d{1,3})%\s+"
    r"(?P<speed>[\d.,]+\s*[kMGT]?B/s)\s+"
    r"(?P<eta>\d+:\d+:\d+)"
)


def parse_progress_record(record: str):
    """Parse one rsync --info=progress2 update (rsync separates updates with CR)."""
    match = _PROGRESS_RE.search(record)
    if not match:
        return None
    return int(match.group("percent")), match.group("speed").strip(), match.group("eta")


class RsyncProgressParser:
    """Collect progress records even when pipe reads split or join CR updates."""

    def __init__(self):
        self._buffer = ""

    def feed(self, text: str):
        self._buffer += text
        updates = []
        while True:
            match = re.search(r"[\r\n]", self._buffer)
            if match is None:
                break
            record = self._buffer[:match.start()]
            self._buffer = self._buffer[match.end():]
            parsed = parse_progress_record(record)
            if parsed is not None:
                updates.append(parsed)
        return updates

    def finish(self):
        parsed = parse_progress_record(self._buffer)
        self._buffer = ""
        return parsed

def main():
    src = sys.argv[1] if len(sys.argv) > 1 else "/"
    dest = sys.argv[2] if len(sys.argv) > 2 else "/mnt/"

    excludes = [
        "/dev/*", "/proc/*", "/sys/*", "/tmp/*", "/run/*",
        "/mnt/*", "/media/*", "/lost+found", "/run/archiso/*"
    ]
    exclude_args = []
    for exc in excludes:
        exclude_args.extend(["--exclude", exc])

    cmd = [
        "rsync", "-aAX", "--delete", "--info=progress2", "--no-inc-recursive",
        "--outbuf=none",
    ] + exclude_args + [src, dest]

    with Progress(
        SpinnerColumn(spinner_name="dots"),
        TextColumn("[bold cyan]{task.description}[/bold cyan]"),
        BarColumn(bar_width=35, style="grey37", complete_style="bold green"),
        TextColumn("[bold white]{task.percentage:>3.0f}%[/bold white]"),
        TextColumn("[green]{task.fields[speed]}[/green]"),
        TextColumn("[yellow]{task.fields[eta]}[/yellow]"),
        console=console,
        transient=False,
    ) as progress:
        task = progress.add_task("Instalando arquivos no SSD", total=100, speed="Calculando...", eta="--:--")

        process = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            bufsize=0,
        )

        parser = RsyncProgressParser()
        try:
            while True:
                chunk = os.read(process.stdout.fileno(), 4096)
                if not chunk:
                    break
                for percent, speed, eta in parser.feed(chunk.decode("utf-8", errors="replace")):
                    progress.update(task, completed=percent, speed=speed, eta=f"ETA: {eta}")
            final_update = parser.finish()
            if final_update:
                percent, speed, eta = final_update
                progress.update(task, completed=percent, speed=speed, eta=f"ETA: {eta}")
        except OSError as exc:
            console.print(f"[yellow]Não foi possível ler o progresso do rsync: {exc}[/yellow]")

        process.wait()
        if process.returncode != 0:
            console.print(f"[bold red]Erro na gravação dos arquivos do sistema.[/bold red]")
            sys.exit(process.returncode)

        progress.update(task, completed=100, speed="[bold green]Concluído[/bold green]", eta="")

if __name__ == "__main__":
    main()
