#!/usr/bin/env bash
# /usr/local/bin/vhackintosh-xsession
# Sessão X11 gerenciada com Openbox para modo Kiosk Appliance (Fullscreen e Input Focus)
set -e

# Inicia Openbox em background para fornecer EWMH, fullscreen e foco automático de entrada
if command -v openbox >/dev/null 2>&1; then
    openbox &
    OPENBOX_PID=$!
fi

# Desativa screensaver e DPMS na sessão gráfica do macOS
if command -v xset >/dev/null 2>&1; then
    xset s off 2>/dev/null || true
    xset -dpms 2>/dev/null || true
fi

# Executa o QEMU com o macOS
"$@"
STATUS=$?

# Encerra openbox ao sair da VM
if [ -n "${OPENBOX_PID:-}" ]; then
    kill "$OPENBOX_PID" 2>/dev/null || true
fi

exit $STATUS
