#!/usr/bin/env bash
# ==============================================================================
# vHackintosh OS — Bare-Metal Disk Installer
# Instala o Appliance vHackintosh dedicado no SSD/NVMe do computador.
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

clear
echo -e "${CYAN}======================================================================${NC}"
echo -e "${BOLD}${CYAN}          vHackintosh OS — Assistente de Instalação no Disco         ${NC}"
echo -e "${CYAN}======================================================================${NC}\n"

if [ "$(id -u)" -ne 0 ]; then
    echo -e "${RED}Erro: O instalador de disco requer privilégios de superusuário (root).${NC}"
    echo -e "Execute: ${YELLOW}sudo vhackintosh-install${NC}"
    exit 1
fi

# Detecta dispositivo de boot da ISO para não permitir instalar em cima do próprio pendrive
BOOT_DEV=""
if [ -d "/run/archiso/bootmnt" ]; then
    BOOT_DEV=$(df /run/archiso/bootmnt | awk 'NR==2 {print $1}' | sed -E 's/[0-9]+$|p[0-9]+$//')
fi

echo -e "${BOLD}Detectando discos físicos disponíveis no sistema:${NC}\n"

# Lista discos elegíveis (excluindo loop, ram, zram e o instalador USB)
DISKS=()
DISK_INFO=()

while IFS= read -r line; do
    DEV_NAME=$(echo "$line" | awk '{print $1}')
    DEV_SIZE=$(echo "$line" | awk '{print $2}')
    DEV_MODEL=$(echo "$line" | cut -d' ' -f3-)
    DEV_PATH="/dev/${DEV_NAME}"

    if [[ "$DEV_NAME" =~ ^(loop|ram|zram|sr|airoot) ]]; then
        continue
    fi
    if [ -n "$BOOT_DEV" ] && [ "$DEV_PATH" = "$BOOT_DEV" ]; then
        continue
    fi

    DISKS+=("$DEV_PATH")
    DISK_INFO+=("$DEV_PATH ($DEV_SIZE) - $DEV_MODEL")
done < <(lsblk -d -n -o NAME,SIZE,MODEL 2>/dev/null)

if [ "${#DISKS[@]}" -eq 0 ]; then
    echo -e "${RED}Nenhum disco rígido ou SSD elegível encontrado no sistema!${NC}"
    echo -e "Verifique se o seu SSD/NVMe está conectado e habilitado em modo AHCI na BIOS."
    exit 1
fi

for i in "${!DISK_INFO[@]}"; do
    echo -e "  [${GREEN}$((i + 1))${NC}] ${BOLD}${DISK_INFO[$i]}${NC}"
done
echo -e "  [${YELLOW}0${NC}] Cancelar e Sair\n"

read -rp "Selecione o número do disco de destino para a instalação: " choice

if [ "$choice" = "0" ] || [ -z "$choice" ]; then
    echo -e "\nOperação cancelada pelo usuário."
    exit 0
fi

IDX=$((choice - 1))
if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#DISKS[@]}" ]; then
    echo -e "${RED}Opção inválida!${NC}"
    exit 1
fi

TARGET_DISK="${DISKS[$IDX]}"

echo -e "\n${RED}======================================================================${NC}"
echo -e "${BOLD}${RED}                       ATENÇÃO: FORMATAÇÃO TOTAL                     ${NC}"
echo -e "${RED}======================================================================${NC}"
echo -e "O disco ${BOLD}${YELLOW}${TARGET_DISK}${NC} será ${BOLD}${RED}COMPLETAMENTE FORMATADO${NC}!"
echo -e "Todos os dados, sistemas operacionais e arquivos serão substituídos"
echo -e "pelo vHackintosh OS dedicado.\n"

read -rp "Tem certeza absoluta que deseja prosseguir? Digite 'SIM' para confirmar: " confirm
if [ "$confirm" != "SIM" ]; then
    echo -e "\nConfirmação não recebida. Instalação abortada."
    exit 0
fi

echo -e "\n${CYAN}▶ 1/6 Preparando partições GPT e sistema de arquivos UEFI...${NC}"
# Desmonta qualquer partição do disco que esteja montada
umount -f "${TARGET_DISK}"* 2>/dev/null || true

# Cria tabela GPT limpa
parted -s "${TARGET_DISK}" mklabel gpt
parted -s "${TARGET_DISK}" mkpart "EFI" fat32 1MiB 1025MiB
parted -s "${TARGET_DISK}" set 1 esp on
parted -s "${TARGET_DISK}" mkpart "VHACK_ROOT" ext4 1025MiB 100%

# Identifica nomes das partições geradas (lida com nvme0n1p1 vs sda1)
if [[ "${TARGET_DISK}" =~ [0-9]$ ]]; then
    PART_EFI="${TARGET_DISK}p1"
    PART_ROOT="${TARGET_DISK}p2"
else
    PART_EFI="${TARGET_DISK}1"
    PART_ROOT="${TARGET_DISK}2"
fi

# Aguarda kernel registrar a nova tabela
sleep 2

echo -e "${CYAN}▶ 2/6 Formatando partições (EFI FAT32 + ROOT Ext4)...${NC}"
mkfs.fat -F32 -n "VHACK_EFI" "${PART_EFI}"
mkfs.ext4 -F -L "VHACK_ROOT" "${PART_ROOT}"

echo -e "${CYAN}▶ 3/6 Montando disco de destino em /mnt...${NC}"
mkdir -p /mnt
mount "${PART_ROOT}" /mnt
mkdir -p /mnt/boot
mount "${PART_EFI}" /mnt/boot

echo -e "${CYAN}▶ 4/6 Copiando sistema vHackintosh para o SSD (rsync)...${NC}"
rsync -aAXv --delete \
    --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found","/run/archiso/*"} \
    / /mnt/

# Cria diretórios essenciais vazios no destino
mkdir -p /mnt/{dev,proc,sys,tmp,run,mnt,media}
chmod 1777 /mnt/tmp

echo -e "${CYAN}▶ 5/6 Gerando tabela de montagem /etc/fstab e configuração de boot...${NC}"
if command -v genfstab >/dev/null 2>&1; then
    genfstab -U /mnt > /mnt/etc/fstab
else
    EFI_UUID=$(blkid -s UUID -o value "${PART_EFI}")
    ROOT_UUID=$(blkid -s UUID -o value "${PART_ROOT}")
    cat <<EOF > /mnt/etc/fstab
UUID=${ROOT_UUID}   /       ext4    rw,relatime,discard    0 1
UUID=${EFI_UUID}    /boot   vfat    rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro 0 2
EOF
fi

# Ajusta hostname do host
echo "vhackintosh-host" > /mnt/etc/hostname

# Remove hooks exclusivos de Live ISO no sistema instalado
rm -f /mnt/etc/mkinitcpio.conf.d/archiso.conf 2>/dev/null || true
rm -f /mnt/etc/systemd/system-generators/systemd-gpt-auto-generator 2>/dev/null || true

echo -e "${CYAN}▶ 6/6 Instalando Bootloader GRUB 2 UEFI e tema Apple...${NC}"
# Monta pseudosistemas de arquivos para chroot
mount --bind /dev /mnt/dev
mount --bind /proc /mnt/proc
mount --bind /sys /mnt/sys

chroot /mnt /bin/bash -c "
    # Regenera initramfs nativo para o hardware do host
    mkinitcpio -P

    # Instala o GRUB UEFI na partição de boot
    grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=vHackintosh --recheck

    # Instala tema do GRUB vHackintosh se disponível
    if [ -f /opt/vhackintosh/themes/grub/install.sh ]; then
        bash /opt/vhackintosh/themes/grub/install.sh || true
    fi

    # Gera configuração de boot do GRUB
    grub-mkconfig -o /boot/grub/grub.cfg

    # Habilita serviços essenciais
    systemctl enable NetworkManager.service 2>/dev/null || true
"

# Desmonta tudo de forma segura
echo -e "\n${BLUE}▶ Sincronizando dados no disco e desmontando partições...${NC}"
sync
umount -R /mnt 2>/dev/null || true

echo -e "\n${GREEN}======================================================================${NC}"
echo -e "${BOLD}${GREEN}        PARABÉNS! vHackintosh OS INSTALADO COM SUCESSO!               ${NC}"
echo -e "${GREEN}======================================================================${NC}\n"
echo -e "O seu computador agora é um vHackintosh Appliance dedicado de alto desempenho."
echo -e "1. Remova o pendrive de instalação USB."
echo -e "2. Pressione ${BOLD}Enter${NC} para reiniciar o computador no vHackintosh OS."

read -rp ""
reboot
