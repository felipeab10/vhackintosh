#!/usr/bin/env bash
# ==============================================================================
# vHackintosh OS — Bare-Metal Disk Installer & Partition Manager
# Gerenciador de Partições com suporte a Modo Automático e Modo Manual (cfdisk).
# ==============================================================================

set -euo pipefail

INSTALL_I18N="/usr/local/lib/vhackintosh-install-i18n.sh"
if [ -r "$INSTALL_I18N" ]; then
    # shellcheck source=/dev/null
    . "$INSTALL_I18N"
fi

VHACK_INSTALL_LANGUAGE="${VHACK_INSTALL_LANGUAGE:-${VHACK_LANGUAGE:-}}"
if [[ "$VHACK_INSTALL_LANGUAGE" != "en" && "$VHACK_INSTALL_LANGUAGE" != "pt" ]]; then
    VHACK_INSTALL_LANGUAGE=""
    LANG_HELPER="/opt/vhackintosh/bin/vhackintosh-lang"
    if [ -x "$LANG_HELPER" ]; then
        if [ -n "${SUDO_USER:-}" ] && command -v sudo >/dev/null 2>&1; then
            VHACK_INSTALL_LANGUAGE="$(sudo -u "$SUDO_USER" -- "$LANG_HELPER" --get-code 2>/dev/null || true)"
        else
            VHACK_INSTALL_LANGUAGE="$("$LANG_HELPER" --get-code 2>/dev/null || true)"
        fi
    fi
fi
case "$VHACK_INSTALL_LANGUAGE" in
    en|pt) ;;
    *) VHACK_INSTALL_LANGUAGE="pt" ;;
esac
export VHACK_INSTALL_LANGUAGE
if [ "$VHACK_INSTALL_LANGUAGE" = "en" ]; then
    export LANG=C.UTF-8 LC_ALL=C.UTF-8
fi

if ! declare -F vhack_install_msg >/dev/null 2>&1; then
    vhack_install_msg() { printf '%s' "$1"; }
fi

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
MAGENTA='\033[1;35m'
BLUE='\033[0;34m'
NC='\033[0m'

clear
echo -e "${CYAN}======================================================================${NC}"
echo -e "${BOLD}${CYAN}          $(vhack_install_msg title)      ${NC}"
echo -e "${CYAN}======================================================================${NC}\n"

if [ "$(id -u)" -ne 0 ]; then
    echo -e "${RED}$(vhack_install_msg root_error)${NC}"
    echo -e "$(vhack_install_msg root_command)"
    exit 1
fi

# ------------------------------------------------------------------------------
# Pré-validação de Compatibilidade de Hardware:
# Impede a destruição/formatação de discos caso o computador não atenda aos
# requisitos obrigatórios do vHackintosh OS (KVM na BIOS e Reims vGPU / Vulkan 1.2+).
# ------------------------------------------------------------------------------
echo -e "${CYAN}$(vhack_install_msg hardware_check)${NC}"

CHECK_OK=1
CHECK_ERR=""
if command -v vhackintosh >/dev/null 2>&1; then
    if ! CHECK_ERR="$(vhackintosh check 2>&1)"; then
        CHECK_OK=0
    fi
elif [ -f "/opt/vhackintosh/bin/vhackintosh" ]; then
    if ! CHECK_ERR="$(/opt/vhackintosh/bin/vhackintosh check 2>&1)"; then
        CHECK_OK=0
    fi
fi

if [ "$CHECK_OK" -ne 1 ]; then
    echo -e "\n${RED}======================================================================${NC}"
    echo -e "${BOLD}${RED}  $(vhack_install_msg blocked_title)     ${NC}"
    echo -e "${RED}======================================================================${NC}\n"
    echo -e "${YELLOW}$(vhack_install_msg blocked_body)${NC}\n"
    echo -e "${BOLD}$(vhack_install_msg diagnostic)${NC}"
    echo -e "${CHECK_ERR}\n"
    echo -e "$(vhack_install_msg data_warning)\n"
    echo -e "${BOLD}$(vhack_install_msg requirements)${NC}"
    echo -e "  $(vhack_install_msg cpu_requirement)"
    echo -e "  $(vhack_install_msg gpu_requirement)"
    echo -e "  $(vhack_install_msg physical_requirement)\n"
    echo -e "${RED}$(vhack_install_msg install_aborted)${NC}\n"
    while true; do
        echo -ne "${YELLOW}$(vhack_install_msg shutdown_prompt)${NC}"
        read -r shutdown_key
        if [ "$shutdown_key" = "r" ] || [ "$shutdown_key" = "R" ]; then
            echo -e "\n${CYAN}$(vhack_install_msg rebooting)${NC}"
            reboot
        else
                echo -e "\n${RED}$(vhack_install_msg powering_off)${NC}"
            if command -v systemctl >/dev/null 2>&1; then
                systemctl poweroff -i || poweroff
            else
                poweroff
            fi
        fi
        sleep 2
    done
    exit 1
fi
echo -e "${GREEN}$(vhack_install_msg hardware_ok)${NC}\n"

trap 'echo -e "\n${RED}$(vhack_install_msg error_line "$LINENO")${NC}\n$(vhack_install_msg press_return)"; read -r' ERR

# Detecta dispositivo de boot da ISO para proteger o instalador USB
BOOT_DEV=""
for cand in /run/archiso/bootmnt /run/archiso/img_dev /run/archiso/cowspace /run/archiso; do
    if [ -e "$cand" ]; then
        BOOT_DEV=$(df "$cand" 2>/dev/null | awk 'NR==2 {print $1}' | sed -E 's/[0-9]+$|p[0-9]+$//' || true)
        [ -n "$BOOT_DEV" ] && break
    fi
done

echo -e "${BOLD}$(vhack_install_msg detect_disks)${NC}\n"

DISKS=()
DISK_INFO=()

while IFS= read -r line; do
    DEV_NAME=$(echo "$line" | awk '{print $1}')
    DEV_SIZE_BYTES=$(echo "$line" | awk '{print $2}')
    DEV_RO=$(echo "$line" | awk '{print $3}')
    DEV_MODEL=$(echo "$line" | cut -d' ' -f4-)
    DEV_PATH="/dev/${DEV_NAME}"

    if [[ "$DEV_NAME" =~ ^(loop|ram|zram|sr|airoot|fd|md) ]]; then
        continue
    fi
    if [ "$DEV_RO" = "1" ]; then
        continue
    fi
    # Ignora dispositivos menores que 10 GB (disquetes, partições ram, etc.)
    if [ "${DEV_SIZE_BYTES:-0}" -lt 10737418240 ] 2>/dev/null; then
        continue
    fi
    if [ -n "$BOOT_DEV" ] && [ "$DEV_PATH" = "$BOOT_DEV" ]; then
        continue
    fi

    DEV_SIZE_HUMAN=$(lsblk -d -n -o SIZE "${DEV_PATH}" 2>/dev/null || echo "$DEV_SIZE_BYTES")
    DISKS+=("$DEV_PATH")
    DISK_INFO+=("$DEV_PATH (${DEV_SIZE_HUMAN}) - ${DEV_MODEL:-$(vhack_install_msg unknown_disk)}")
done < <(lsblk -d -n -b -o NAME,SIZE,RO,MODEL 2>/dev/null)

if [ "${#DISKS[@]}" -eq 0 ]; then
    echo -e "${RED}$(vhack_install_msg no_disk)${NC}"
    echo -e "$(vhack_install_msg check_sata)"
    exit 1
fi

for i in "${!DISK_INFO[@]}"; do
    echo -e "  [${GREEN}$((i + 1))${NC}] ${BOLD}${DISK_INFO[$i]}${NC}"
done
echo -e "  [${YELLOW}0${NC}] $(vhack_install_msg cancel_exit)\n"

read -rp "$(vhack_install_msg select_disk)" disk_choice

if [ "$disk_choice" = "0" ] || [ -z "$disk_choice" ]; then
    echo -e "\n$(vhack_install_msg cancelled)"
    exit 0
fi

IDX=$((disk_choice - 1))
if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#DISKS[@]}" ]; then
    echo -e "${RED}$(vhack_install_msg invalid_option)${NC}"
    exit 1
fi

TARGET_DISK="${DISKS[$IDX]}"

# ------------------------------------------------------------------------------
# Seleção do Modo de Particionamento (Automático vs Manual)
# ------------------------------------------------------------------------------
clear
echo -e "${CYAN}======================================================================${NC}"
echo -e "${BOLD}${CYAN}                $(vhack_install_msg partition_title)                   ${NC}"
echo -e "${CYAN}======================================================================${NC}\n"
echo -e "$(vhack_install_msg selected_disk "$TARGET_DISK")\n"

echo -e "  [${GREEN}1${NC}] ${BOLD}$(vhack_install_msg automatic_mode)${NC}"
echo -e "      $(vhack_install_msg automatic_desc1)"
echo -e "      $(vhack_install_msg automatic_desc2)\n"

echo -e "  [${MAGENTA}2${NC}] ${BOLD}$(vhack_install_msg manual_mode)${NC}"
echo -e "      $(vhack_install_msg manual_desc1)"
echo -e "      $(vhack_install_msg manual_desc2)\n"

echo -e "  [${YELLOW}0${NC}] $(vhack_install_msg cancelled)\n"

read -rp "$(vhack_install_msg partition_prompt)" part_mode

if [ "$part_mode" = "0" ] || [ -z "$part_mode" ]; then
    echo -e "\n$(vhack_install_msg cancelled)"
    exit 0
fi

# Variáveis para a fase de instalação
PART_EFI=""
PART_ROOT=""
PART_SWAP=""
FORMAT_EFI=true
FORMAT_ROOT=true
ROOT_FSTYPE="ext4"

# ------------------------------------------------------------------------------
# 1. MODO AUTOMÁTICO
# ------------------------------------------------------------------------------
if [ "$part_mode" = "1" ]; then
    echo -e "\n${RED}======================================================================${NC}"
    echo -e "${BOLD}${RED}                       $(vhack_install_msg format_warning)                     ${NC}"
    echo -e "${RED}======================================================================${NC}"
    echo -e "$(vhack_install_msg will_format "$TARGET_DISK")"
    echo -e "$(vhack_install_msg erase_warning)\n"

    read -rp "$(vhack_install_msg format_confirmation)" confirm
    if [[ "${confirm,,}" != "sim" && "${confirm,,}" != "yes" ]]; then
        echo -e "\n$(vhack_install_msg confirmation_failed)"
        exit 0
    fi

    echo -e "\n${CYAN}$(vhack_install_msg create_gpt)${NC}"
    umount -f "${TARGET_DISK}"* 2>/dev/null || true

    parted -s "${TARGET_DISK}" mklabel gpt
    parted -s "${TARGET_DISK}" mkpart "EFI" fat32 1MiB 1025MiB
    parted -s "${TARGET_DISK}" set 1 esp on
    parted -s "${TARGET_DISK}" mkpart "VHACK_ROOT" ext4 1025MiB 100%

    udevadm settle || sleep 2
    partprobe "${TARGET_DISK}" 2>/dev/null || true
    sleep 1

    if [[ "${TARGET_DISK}" =~ [0-9]$ ]]; then
        PART_EFI="${TARGET_DISK}p1"
        PART_ROOT="${TARGET_DISK}p2"
    else
        PART_EFI="${TARGET_DISK}1"
        PART_ROOT="${TARGET_DISK}2"
    fi

    if [ ! -b "${PART_EFI}" ] || [ ! -b "${PART_ROOT}" ]; then
        echo -e "${RED}$(vhack_install_msg partitions_missing "$PART_EFI" "$PART_ROOT")${NC}"
        exit 1
    fi

# ------------------------------------------------------------------------------
# 2. MODO MANUAL
# ------------------------------------------------------------------------------
elif [ "$part_mode" = "2" ]; then
    clear
    echo -e "${CYAN}======================================================================${NC}"
    echo -e "${BOLD}${CYAN}       $(vhack_install_msg manual_requirements)       ${NC}"
    echo -e "${CYAN}======================================================================${NC}\n"

    echo -e "${BOLD}$(vhack_install_msg efi_required)${NC}"
    echo -e "   $(vhack_install_msg efi_size)"
    echo -e "   $(vhack_install_msg efi_type)"
    echo -e "   $(vhack_install_msg efi_fs)"
    echo -e "   $(vhack_install_msg efi_tip)\n"

    echo -e "${BOLD}$(vhack_install_msg root_required)${NC}"
    echo -e "   $(vhack_install_msg root_size)"
    echo -e "   $(vhack_install_msg root_type)"
    echo -e "   $(vhack_install_msg root_fs)\n"

    echo -e "${BOLD}$(vhack_install_msg swap_optional)${NC}"
    echo -e "   $(vhack_install_msg swap_size)"
    echo -e "   $(vhack_install_msg swap_type)\n"

    echo -e "${CYAN}----------------------------------------------------------------------${NC}"
    read -rp "$(vhack_install_msg open_cfdisk "$TARGET_DISK")" open_cfdisk
    if [[ ! "$open_cfdisk" =~ ^[Nn]$ ]]; then
        cfdisk "${TARGET_DISK}"
    fi

    # Atualiza tabela de partições no kernel
    partprobe "${TARGET_DISK}" 2>/dev/null || true
    sleep 2

    # Lista partições disponíveis no disco
    clear
    echo -e "${BOLD}$(vhack_install_msg detected_partitions "$TARGET_DISK")${NC}\n"
    lsblk "${TARGET_DISK}" -o NAME,SIZE,FSTYPE,TYPE,MOUNTPOINTS

    echo -e "\n${CYAN}----------------------------------------------------------------------${NC}"
    echo -e "${BOLD}$(vhack_install_msg partition_mapping)${NC}\n"

    # Seleção da Partição EFI
    read -rp "$(vhack_install_msg efi_path "$TARGET_DISK")" user_efi
    if [[ ! "$user_efi" =~ ^/dev/ ]]; then
        user_efi="/dev/${user_efi}"
    fi
    if [ ! -b "$user_efi" ]; then
        echo -e "${RED}$(vhack_install_msg device_invalid "$user_efi")${NC}"
        exit 1
    fi
    PART_EFI="$user_efi"

    read -rp "$(vhack_install_msg format_efi)" fmt_efi_ans
    if [[ "$fmt_efi_ans" =~ ^[Ss]$ ]]; then
        FORMAT_EFI=true
    else
        FORMAT_EFI=false
    fi

    # Seleção da Partição Raiz (Root)
    read -rp "$(vhack_install_msg root_path "$TARGET_DISK")" user_root
    if [[ ! "$user_root" =~ ^/dev/ ]]; then
        user_root="/dev/${user_root}"
    fi
    if [ ! -b "$user_root" ]; then
        echo -e "${RED}$(vhack_install_msg device_invalid "$user_root")${NC}"
        exit 1
    fi
    PART_ROOT="$user_root"

    echo -e "\n$(vhack_install_msg root_fs_choice)"
    echo -e "  [1] $(vhack_install_msg ext4_choice)"
    echo -e "  [2] $(vhack_install_msg btrfs_choice)"
    read -rp "$(vhack_install_msg fs_prompt)" fs_ans
    if [ "$fs_ans" = "2" ]; then
        ROOT_FSTYPE="btrfs"
    else
        ROOT_FSTYPE="ext4"
    fi

    read -rp "$(vhack_install_msg format_root "$PART_ROOT" "$ROOT_FSTYPE")" fmt_root_ans
    if [[ "$fmt_root_ans" =~ ^[Nn]$ ]]; then
        FORMAT_ROOT=false
    else
        FORMAT_ROOT=true
    fi

    # Seleção da Partição Swap (Opcional)
    read -rp "$(vhack_install_msg swap_prompt)" user_swap
    if [ -n "$user_swap" ]; then
        if [[ ! "$user_swap" =~ ^/dev/ ]]; then
            user_swap="/dev/${user_swap}"
        fi
        if [ -b "$user_swap" ]; then
            PART_SWAP="$user_swap"
        fi
    fi

    # Resumo antes da gravação
    clear
    echo -e "${CYAN}======================================================================${NC}"
    echo -e "${BOLD}${CYAN}                  $(vhack_install_msg summary_title)                       ${NC}"
    echo -e "${CYAN}======================================================================${NC}\n"
    EFI_FORMAT_LABEL="$(vhack_install_msg no)"
    ROOT_FORMAT_LABEL="$(vhack_install_msg no)"
    [ "$FORMAT_EFI" = true ] && EFI_FORMAT_LABEL="$(vhack_install_msg yes)"
    [ "$FORMAT_ROOT" = true ] && ROOT_FORMAT_LABEL="$(vhack_install_msg yes)"
    echo -e "  $(vhack_install_msg summary_efi "$PART_EFI" "$EFI_FORMAT_LABEL")"
    echo -e "  $(vhack_install_msg summary_root "$PART_ROOT" "$ROOT_FSTYPE" "$ROOT_FORMAT_LABEL")"
    echo -e "  $(vhack_install_msg summary_swap "${PART_SWAP:-$(vhack_install_msg none)}")\n"

    read -rp "$(vhack_install_msg proceed_prompt)" final_confirm
    if [[ "$final_confirm" =~ ^[Nn]$ ]]; then
        echo -e "\n$(vhack_install_msg cancelled_user)"
        exit 0
    fi
else
    echo -e "${RED}$(vhack_install_msg invalid_option)${NC}"
    exit 1
fi

# ------------------------------------------------------------------------------
# 3. EXECUÇÃO DA FORMATAÇÃO E MONTAGEM
# ------------------------------------------------------------------------------
echo -e "\n${CYAN}$(vhack_install_msg step_format)${NC}"

# Desmonta antes de formatar
umount -f "${PART_ROOT}" 2>/dev/null || true
umount -f "${PART_EFI}" 2>/dev/null || true

# Formatação EFI
if [ "$FORMAT_EFI" = true ]; then
    echo -e "  $(vhack_install_msg formatting_efi "$PART_EFI")"
    mkfs.fat -F32 -n "VHACK_EFI" "${PART_EFI}"
fi

# Formatação Raiz
if [ "$FORMAT_ROOT" = true ]; then
    echo -e "  $(vhack_install_msg formatting_root "$PART_ROOT" "$ROOT_FSTYPE")"
    if [ "$ROOT_FSTYPE" = "btrfs" ]; then
        mkfs.btrfs -f -L "VHACK_ROOT" "${PART_ROOT}"
    else
        mkfs.ext4 -F -L "VHACK_ROOT" "${PART_ROOT}"
    fi
fi

# Ativação do Swap se configurado
if [ -n "$PART_SWAP" ]; then
    echo -e "  $(vhack_install_msg activating_swap "$PART_SWAP")"
    mkswap -f "${PART_SWAP}" 2>/dev/null || true
    swapon "${PART_SWAP}" 2>/dev/null || true
fi

echo -e "\n${CYAN}$(vhack_install_msg step_mount)${NC}"
mkdir -p /mnt
mount "${PART_ROOT}" /mnt
mkdir -p /mnt/boot
mount "${PART_EFI}" /mnt/boot

echo -e "\n${CYAN}$(vhack_install_msg step_copy)${NC}"
if [ -f /usr/local/bin/vhack-copy-system ]; then
    /usr/local/bin/vhack-copy-system "/" "/mnt/"
else
    rsync -aAX --info=progress2 --no-inc-recursive \
        --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found","/run/archiso/*","/var/lib/vhackintosh/web/***"} \
        / /mnt/
fi

# Diretórios virtuais no destino
mkdir -p /mnt/{dev,proc,sys,tmp,run,mnt,media}
chmod 1777 /mnt/tmp

# Garanta o auto-start mesmo se o rsync não preservar os links do perfil live.
# Os dois arquivos de unidade fazem parte da ISO e precisam existir no destino;
# links relativos são resolvidos pelo systemd no boot instalado.
SYSTEMD_WANTS_DIR="/mnt/etc/systemd/system/multi-user.target.wants"
for service in vhackintosh-agent.service vhackintosh-web.service vhackintosh-http-redirect.service; do
    if [ ! -f "/mnt/etc/systemd/system/${service}" ]; then
        echo -e "${RED}$(vhack_install_msg missing_unit "$service")${NC}"
        exit 1
    fi
done
if [ ! -e "/mnt/usr/lib/systemd/system/seatd.service" ]; then
    echo -e "${RED}$(vhack_install_msg missing_seatd)${NC}"
    exit 1
fi
mkdir -p "${SYSTEMD_WANTS_DIR}"
ln -sfn ../vhackintosh-agent.service "${SYSTEMD_WANTS_DIR}/vhackintosh-agent.service"
ln -sfn ../vhackintosh-web.service "${SYSTEMD_WANTS_DIR}/vhackintosh-web.service"
ln -sfn ../vhackintosh-http-redirect.service "${SYSTEMD_WANTS_DIR}/vhackintosh-http-redirect.service"

# A debug ISO carries the temporary SSH public key and a key-only sshd config.
# Preserve remote diagnostics on the installed appliance as well as in live mode.
if [ -f "/mnt/etc/ssh/sshd_config.d/00-vhackintosh-debug.conf" ]; then
    if [ ! -f "/mnt/usr/lib/systemd/system/sshd.service" ]; then
        echo -e "${RED}$(vhack_install_msg missing_sshd)${NC}"
        exit 1
    fi
    ln -sfn /usr/lib/systemd/system/sshd.service "${SYSTEMD_WANTS_DIR}/sshd.service"
fi

echo -e "\n${CYAN}$(vhack_install_msg step_fstab)${NC}"
if command -v genfstab >/dev/null 2>&1; then
    genfstab -U /mnt > /mnt/etc/fstab
else
    EFI_UUID=$(blkid -s UUID -o value "${PART_EFI}")
    ROOT_UUID=$(blkid -s UUID -o value "${PART_ROOT}")
    cat <<EOF > /mnt/etc/fstab
UUID=${ROOT_UUID}   /       ${ROOT_FSTYPE}    rw,relatime,discard    0 1
UUID=${EFI_UUID}    /boot   vfat    rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro 0 2
EOF
    if [ -n "$PART_SWAP" ]; then
        SWAP_UUID=$(blkid -s UUID -o value "${PART_SWAP}" || true)
        if [ -n "$SWAP_UUID" ]; then
            echo "UUID=${SWAP_UUID}   none    swap    defaults    0 0" >> /mnt/etc/fstab
        fi
    fi
fi

# Hostname fixo para o Appliance
echo "vhackintosh-host" > /mnt/etc/hostname

# Limpa hooks de live boot no sistema instalado
rm -f /mnt/etc/mkinitcpio.conf.d/archiso.conf 2>/dev/null || true
rm -f /mnt/etc/systemd/system-generators/systemd-gpt-auto-generator 2>/dev/null || true

# Marca positivamente o sistema como INSTALADO em disco.
# Esta evidência é lida por `vhackintosh-mode` e desativa o menu de Live USB,
# evitando que o instalador seja oferecido novamente a cada boot. Deve ser
# gravada APÓS a cópia rsync (que usa --delete) para não ser removida.
mkdir -p /mnt/etc/vhackintosh
cat <<EOF > /mnt/etc/vhackintosh/installed
mode=installed
installed_at=$(date -Is 2>/dev/null || date)
installer_version=1.0.0
target_disk=${TARGET_DISK}
efi_partition=${PART_EFI}
root_partition=${PART_ROOT}
root_fstype=${ROOT_FSTYPE}
EOF
chmod 644 /mnt/etc/vhackintosh/installed
echo -e "  $(vhack_install_msg install_marker)"

# Permissões de execução dos binários
chmod +x /mnt/opt/vhackintosh/bin/* 2>/dev/null || true
chmod +x /mnt/opt/vhackintosh/resources/macserial/macserial 2>/dev/null || true
chmod +x /mnt/opt/vhackintosh/themes/grub/install.sh 2>/dev/null || true
chmod +x /mnt/usr/local/bin/* 2>/dev/null || true

# Copia o kernel do Linux para /mnt/boot/vmlinuz-linux
echo -e "  $(vhack_install_msg install_kernel)"
if [ ! -f /mnt/boot/vmlinuz-linux ]; then
    KERNEL_FOUND=""
    for k in "/run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux" \
             "/run/archiso/bootmnt/arch/boot/x86_64/vmlinuz" \
             $(find /mnt/usr/lib/modules -name "vmlinuz" 2>/dev/null | head -n 1) \
             $(find /run/archiso -name "vmlinuz*" 2>/dev/null | head -n 1); do
        if [ -n "$k" ] && [ -f "$k" ]; then
            KERNEL_FOUND="$k"
            break
        fi
    done
    if [ -n "$KERNEL_FOUND" ]; then
        cp -a "$KERNEL_FOUND" /mnt/boot/vmlinuz-linux
    fi
fi

echo -e "\n${CYAN}$(vhack_install_msg step_bootloader)${NC}"

# Chroot compatível (usa arch-chroot se disponível para propagar efivars automaticamente)
if command -v arch-chroot >/dev/null 2>&1; then
    CHROOT_EXEC="arch-chroot /mnt"
else
    mount --bind /dev /mnt/dev
    mount --bind /proc /mnt/proc
    mount --bind /sys /mnt/sys
    if [ -d /sys/firmware/efi/efivars ]; then
        mount --bind /sys/firmware/efi/efivars /mnt/sys/firmware/efi/efivars 2>/dev/null || true
    fi
    CHROOT_EXEC="chroot /mnt"
fi

$CHROOT_EXEC /bin/bash -c "
    # Cria o initramfs definitivo para o hardware real
    mkinitcpio -P || true

    # Instala o GRUB UEFI com fallback universal --removable (funciona em qualquer placa-mãe ou VM)
    grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=vHackintosh --removable --recheck || \
    grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=vHackintosh --no-nvram --removable --recheck

    # Aplica o tema personalizado do GRUB vHackintosh
    if [ -f /opt/vhackintosh/themes/grub/install.sh ]; then
        bash /opt/vhackintosh/themes/grub/install.sh || true
    fi

    # Gera a lista de boot do GRUB
    grub-mkconfig -o /boot/grub/grub.cfg

    # Habilita o gerenciador de conexões de rede
    systemctl enable NetworkManager.service 2>/dev/null || true

    # systemctl enable confirma o estado no gerenciador quando disponível;
    # os links foram criados diretamente em /etc antes do chroot acima.
    systemctl enable vhackintosh-agent.service vhackintosh-web.service vhackintosh-http-redirect.service || true
"

# Não conclua uma instalação que ficou sem auto-start do painel.
for service in vhackintosh-agent.service vhackintosh-web.service vhackintosh-http-redirect.service; do
    if [ "$(readlink -f "${SYSTEMD_WANTS_DIR}/${service}" 2>/dev/null || true)" != "/mnt/etc/systemd/system/${service}" ]; then
        echo -e "${RED}$(vhack_install_msg enable_unit "$service")${NC}"
        exit 1
    fi
done
if [ -f "/mnt/etc/ssh/sshd_config.d/00-vhackintosh-debug.conf" ] && \
   [ "$(readlink "${SYSTEMD_WANTS_DIR}/sshd.service" 2>/dev/null || true)" != "/usr/lib/systemd/system/sshd.service" ]; then
    echo -e "${RED}$(vhack_install_msg enable_debug_ssh)${NC}"
    exit 1
fi

echo -e "\n${BLUE}$(vhack_install_msg syncing)${NC}"
sync
umount -R /mnt 2>/dev/null || true

echo -e "\n${GREEN}======================================================================${NC}"
echo -e "${BOLD}${GREEN}        $(vhack_install_msg success_title)               ${NC}"
echo -e "${GREEN}======================================================================${NC}\n"
echo -e "$(vhack_install_msg success_body)"
echo -e "$(vhack_install_msg remove_usb)"
echo -e "$(vhack_install_msg reboot_instruction)"

read -rp ""
reboot
