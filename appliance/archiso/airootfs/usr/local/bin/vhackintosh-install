#!/usr/bin/env bash
# ==============================================================================
# vHackintosh OS — Bare-Metal Disk Installer & Partition Manager
# Gerenciador de Partições com suporte a Modo Automático e Modo Manual (cfdisk).
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
MAGENTA='\033[1;35m'
BLUE='\033[0;34m'
NC='\033[0m'

clear
echo -e "${CYAN}======================================================================${NC}"
echo -e "${BOLD}${CYAN}          vHackintosh OS — Gerenciador de Partições e Instalação      ${NC}"
echo -e "${CYAN}======================================================================${NC}\n"

if [ "$(id -u)" -ne 0 ]; then
    echo -e "${RED}Erro: O instalador de disco requer privilégios de superusuário (root).${NC}"
    echo -e "Execute: ${YELLOW}sudo vhackintosh-install${NC}"
    exit 1
fi

trap 'echo -e "\n${RED}Erro na execução (linha $LINENO). Verifique as mensagens acima.${NC}\nPressione Enter para voltar..."; read -r' ERR

# Detecta dispositivo de boot da ISO para proteger o instalador USB
BOOT_DEV=""
if [ -d "/run/archiso/bootmnt" ]; then
    BOOT_DEV=$(df /run/archiso/bootmnt 2>/dev/null | awk 'NR==2 {print $1}' | sed -E 's/[0-9]+$|p[0-9]+$//' || true)
fi

echo -e "${BOLD}Detectando discos físicos conectados (filtrando unidades com >= 10 GB):${NC}\n"

DISKS=()
DISK_INFO=()

while IFS= read -r line; do
    DEV_NAME=$(echo "$line" | awk '{print $1}')
    DEV_SIZE_BYTES=$(echo "$line" | awk '{print $2}')
    DEV_RO=$(echo "$line" | awk '{print $3}')
    DEV_MODEL=$(echo "$line" | cut -d' ' -f4-)
    DEV_PATH="/dev/${DEV_NAME}"

    if [[ "$DEV_NAME" =~ ^(loop|ram|zram|sr|airoot|fd|md) ]]; then
        continue
    fi
    if [ "$DEV_RO" = "1" ]; then
        continue
    fi
    # Ignora dispositivos menores que 10 GB (disquetes, partições ram, etc.)
    if [ "${DEV_SIZE_BYTES:-0}" -lt 10737418240 ] 2>/dev/null; then
        continue
    fi
    if [ -n "$BOOT_DEV" ] && [ "$DEV_PATH" = "$BOOT_DEV" ]; then
        continue
    fi

    DEV_SIZE_HUMAN=$(lsblk -d -n -o SIZE "${DEV_PATH}" 2>/dev/null || echo "$DEV_SIZE_BYTES")
    DISKS+=("$DEV_PATH")
    DISK_INFO+=("$DEV_PATH (${DEV_SIZE_HUMAN}) - ${DEV_MODEL:-'Disco Armazenamento'}")
done < <(lsblk -d -n -b -o NAME,SIZE,RO,MODEL 2>/dev/null)

if [ "${#DISKS[@]}" -eq 0 ]; then
    echo -e "${RED}Nenhum disco rígido ou SSD elegível encontrado no sistema!${NC}"
    echo -e "Verifique conexões e se o modo SATA está em AHCI (não RAID) na BIOS."
    exit 1
fi

for i in "${!DISK_INFO[@]}"; do
    echo -e "  [${GREEN}$((i + 1))${NC}] ${BOLD}${DISK_INFO[$i]}${NC}"
done
echo -e "  [${YELLOW}0${NC}] Cancelar e Sair\n"

read -rp "Selecione o número do disco que deseja utilizar: " disk_choice

if [ "$disk_choice" = "0" ] || [ -z "$disk_choice" ]; then
    echo -e "\nOperação cancelada."
    exit 0
fi

IDX=$((disk_choice - 1))
if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#DISKS[@]}" ]; then
    echo -e "${RED}Opção inválida!${NC}"
    exit 1
fi

TARGET_DISK="${DISKS[$IDX]}"

# ------------------------------------------------------------------------------
# Seleção do Modo de Particionamento (Automático vs Manual)
# ------------------------------------------------------------------------------
clear
echo -e "${CYAN}======================================================================${NC}"
echo -e "${BOLD}${CYAN}                Escolha o Método de Particionamento                   ${NC}"
echo -e "${CYAN}======================================================================${NC}\n"
echo -e "Disco selecionado: ${BOLD}${YELLOW}${TARGET_DISK}${NC}\n"

echo -e "  [${GREEN}1${NC}] ${BOLD}Modo Automático (Recomendado - Apagar Disco Inteiro)${NC}"
echo -e "      • Cria automaticamente partição EFI (1 GB, FAT32) e Raiz (Ext4)"
echo -e "      • Ideal para transformar este disco em um appliance dedicado.\n"

echo -e "  [${MAGENTA}2${NC}] ${BOLD}Modo Manual / Avançado (Gerenciador Visual com cfdisk)${NC}"
echo -e "      • Permite criar suas próprias partições ou usar partições existentes"
echo -e "      • Ideal para Dual-Boot ou esquemas de particionamento customizados.\n"

echo -e "  [${YELLOW}0${NC}] Cancelar\n"

read -rp "Escolha a opção [1 ou 2]: " part_mode

if [ "$part_mode" = "0" ] || [ -z "$part_mode" ]; then
    echo -e "\nOperação cancelada."
    exit 0
fi

# Variáveis para a fase de instalação
PART_EFI=""
PART_ROOT=""
PART_SWAP=""
FORMAT_EFI=true
FORMAT_ROOT=true
ROOT_FSTYPE="ext4"

# ------------------------------------------------------------------------------
# 1. MODO AUTOMÁTICO
# ------------------------------------------------------------------------------
if [ "$part_mode" = "1" ]; then
    echo -e "\n${RED}======================================================================${NC}"
    echo -e "${BOLD}${RED}                       ATENÇÃO: FORMATAÇÃO TOTAL                     ${NC}"
    echo -e "${RED}======================================================================${NC}"
    echo -e "O disco ${BOLD}${YELLOW}${TARGET_DISK}${NC} será ${BOLD}${RED}COMPLETAMENTE FORMATADO${NC}!"
    echo -e "Todos os dados e partições serão apagados.\n"

    read -rp "Tem certeza absoluta? Digite 'SIM' para confirmar a formatação: " confirm
    if [ "$confirm" != "SIM" ]; then
        echo -e "\nConfirmação não recebida. Operação abortada."
        exit 0
    fi

    echo -e "\n${CYAN}▶ Criando tabela GPT e partições automáticas...${NC}"
    umount -f "${TARGET_DISK}"* 2>/dev/null || true

    parted -s "${TARGET_DISK}" mklabel gpt
    parted -s "${TARGET_DISK}" mkpart "EFI" fat32 1MiB 1025MiB
    parted -s "${TARGET_DISK}" set 1 esp on
    parted -s "${TARGET_DISK}" mkpart "VHACK_ROOT" ext4 1025MiB 100%

    udevadm settle || sleep 2
    partprobe "${TARGET_DISK}" 2>/dev/null || true
    sleep 1

    if [[ "${TARGET_DISK}" =~ [0-9]$ ]]; then
        PART_EFI="${TARGET_DISK}p1"
        PART_ROOT="${TARGET_DISK}p2"
    else
        PART_EFI="${TARGET_DISK}1"
        PART_ROOT="${TARGET_DISK}2"
    fi

    if [ ! -b "${PART_EFI}" ] || [ ! -b "${PART_ROOT}" ]; then
        echo -e "${RED}Erro: As partições criadas (${PART_EFI}, ${PART_ROOT}) não foram registradas pelo kernel.${NC}"
        exit 1
    fi

# ------------------------------------------------------------------------------
# 2. MODO MANUAL
# ------------------------------------------------------------------------------
elif [ "$part_mode" = "2" ]; then
    clear
    echo -e "${CYAN}======================================================================${NC}"
    echo -e "${BOLD}${CYAN}       REQUISITOS OBRIGATÓRIOS PARA A INSTALAÇÃO DO vHACKINTOSH       ${NC}"
    echo -e "${CYAN}======================================================================${NC}\n"

    echo -e "${BOLD}1. Partição EFI / Boot (${GREEN}OBRIGATÓRIA${NC}):${NC}"
    echo -e "   • Tamanho sugerido: ${GREEN}512 MB a 1024 MB${NC} (mínimo 300 MB)"
    echo -e "   • Tipo no cfdisk:   ${GREEN}EFI System${NC} (Código 'ef00' ou tipo 'EFI System')"
    echo -e "   • Sistema de arq.:  ${GREEN}FAT32${NC} (será montada em /boot)"
    echo -e "   • Dica: Se já possui uma EFI existente de outro OS, pode reutilizá-la sem formatar.\n"

    echo -e "${BOLD}2. Partição Raiz / Root (${GREEN}OBRIGATÓRIA${NC}):${NC}"
    echo -e "   • Tamanho sugerido: ${GREEN}50 GB ou mais${NC} (mínimo 30 GB para as VMs macOS e QCOW2)"
    echo -e "   • Tipo no cfdisk:   ${GREEN}Linux filesystem${NC} (Código '8300')"
    echo -e "   • Sistema de arq.:  ${GREEN}Ext4${NC} ou ${GREEN}Btrfs${NC} (será montada em /)\n"

    echo -e "${BOLD}3. Partição Swap (${YELLOW}OPCIONAL${NC}):${NC}"
    echo -e "   • Tamanho sugerido: ${YELLOW}4 GB a 16 GB${NC}"
    echo -e "   • Tipo no cfdisk:   ${YELLOW}Linux swap${NC} (Código '8200')\n"

    echo -e "${CYAN}----------------------------------------------------------------------${NC}"
    read -rp "Deseja abrir o editor visual 'cfdisk' agora no disco ${TARGET_DISK}? [S/n]: " open_cfdisk
    if [[ ! "$open_cfdisk" =~ ^[Nn]$ ]]; then
        cfdisk "${TARGET_DISK}"
    fi

    # Atualiza tabela de partições no kernel
    partprobe "${TARGET_DISK}" 2>/dev/null || true
    sleep 2

    # Lista partições disponíveis no disco
    clear
    echo -e "${BOLD}Partições detectadas no disco ${TARGET_DISK}:${NC}\n"
    lsblk "${TARGET_DISK}" -o NAME,SIZE,FSTYPE,TYPE,MOUNTPOINTS

    echo -e "\n${CYAN}----------------------------------------------------------------------${NC}"
    echo -e "${BOLD}Mapeamento das Partições para o Sistema:${NC}\n"

    # Seleção da Partição EFI
    read -rp "Informe o caminho da partição EFI (ex: ${TARGET_DISK}1 ou /dev/sda1): " user_efi
    if [[ ! "$user_efi" =~ ^/dev/ ]]; then
        user_efi="/dev/${user_efi}"
    fi
    if [ ! -b "$user_efi" ]; then
        echo -e "${RED}Erro: O dispositivo '${user_efi}' não existe como partição válida!${NC}"
        exit 1
    fi
    PART_EFI="$user_efi"

    read -rp "Deseja FORMATAR a partição EFI em FAT32? (Digite 'n' se for Dual-Boot) [s/N]: " fmt_efi_ans
    if [[ "$fmt_efi_ans" =~ ^[Ss]$ ]]; then
        FORMAT_EFI=true
    else
        FORMAT_EFI=false
    fi

    # Seleção da Partição Raiz (Root)
    read -rp "Informe o caminho da partição Raiz '/' (ex: ${TARGET_DISK}2): " user_root
    if [[ ! "$user_root" =~ ^/dev/ ]]; then
        user_root="/dev/${user_root}"
    fi
    if [ ! -b "$user_root" ]; then
        echo -e "${RED}Erro: O dispositivo '${user_root}' não existe como partição válida!${NC}"
        exit 1
    fi
    PART_ROOT="$user_root"

    echo -e "\nEscolha o sistema de arquivos para a Raiz:"
    echo -e "  [1] Ext4 (Recomendado - Máxima estabilidade para imagens de VM)"
    echo -e "  [2] Btrfs (Suporte a snapshots e subvolumes)"
    read -rp "Opção [1 ou 2] (padrão 1): " fs_ans
    if [ "$fs_ans" = "2" ]; then
        ROOT_FSTYPE="btrfs"
    else
        ROOT_FSTYPE="ext4"
    fi

    read -rp "Deseja FORMATAR a partição Raiz (${PART_ROOT}) em ${ROOT_FSTYPE}? [S/n]: " fmt_root_ans
    if [[ "$fmt_root_ans" =~ ^[Nn]$ ]]; then
        FORMAT_ROOT=false
    else
        FORMAT_ROOT=true
    fi

    # Seleção da Partição Swap (Opcional)
    read -rp "Possui partição Swap para ativar? (Digite o caminho ou pressione Enter para pular): " user_swap
    if [ -n "$user_swap" ]; then
        if [[ ! "$user_swap" =~ ^/dev/ ]]; then
            user_swap="/dev/${user_swap}"
        fi
        if [ -b "$user_swap" ]; then
            PART_SWAP="$user_swap"
        fi
    fi

    # Resumo antes da gravação
    clear
    echo -e "${CYAN}======================================================================${NC}"
    echo -e "${BOLD}${CYAN}                  Resumo do Plano de Instalação                       ${NC}"
    echo -e "${CYAN}======================================================================${NC}\n"
    echo -e "  • Partição EFI:     ${BOLD}${GREEN}${PART_EFI}${NC} (Formatar FAT32: $([ "$FORMAT_EFI" = true ] && echo "SIM" || echo "NÃO"))"
    echo -e "  • Partição Raiz:    ${BOLD}${GREEN}${PART_ROOT}${NC} (${ROOT_FSTYPE} | Formatar: $([ "$FORMAT_ROOT" = true ] && echo "SIM" || echo "NÃO"))"
    echo -e "  • Partição Swap:    ${BOLD}${YELLOW}${PART_SWAP:-Nenhuma}${NC}\n"

    read -rp "Deseja prosseguir com a instalação e gravação dos dados? [S/n]: " final_confirm
    if [[ "$final_confirm" =~ ^[Nn]$ ]]; then
        echo -e "\nInstalação cancelada pelo usuário."
        exit 0
    fi
else
    echo -e "${RED}Opção inválida!${NC}"
    exit 1
fi

# ------------------------------------------------------------------------------
# 3. EXECUÇÃO DA FORMATAÇÃO E MONTAGEM
# ------------------------------------------------------------------------------
echo -e "\n${CYAN}▶ 1/5 Aplicando formatação conforme configurado...${NC}"

# Desmonta antes de formatar
umount -f "${PART_ROOT}" 2>/dev/null || true
umount -f "${PART_EFI}" 2>/dev/null || true

# Formatação EFI
if [ "$FORMAT_EFI" = true ]; then
    echo -e "  • Formatando EFI (${PART_EFI}) em FAT32..."
    mkfs.fat -F32 -n "VHACK_EFI" "${PART_EFI}"
fi

# Formatação Raiz
if [ "$FORMAT_ROOT" = true ]; then
    echo -e "  • Formatando Raiz (${PART_ROOT}) em ${ROOT_FSTYPE}..."
    if [ "$ROOT_FSTYPE" = "btrfs" ]; then
        mkfs.btrfs -f -L "VHACK_ROOT" "${PART_ROOT}"
    else
        mkfs.ext4 -F -L "VHACK_ROOT" "${PART_ROOT}"
    fi
fi

# Ativação do Swap se configurado
if [ -n "$PART_SWAP" ]; then
    echo -e "  • Ativando partição Swap (${PART_SWAP})..."
    mkswap -f "${PART_SWAP}" 2>/dev/null || true
    swapon "${PART_SWAP}" 2>/dev/null || true
fi

echo -e "\n${CYAN}▶ 2/5 Montando estrutura de diretórios em /mnt...${NC}"
mkdir -p /mnt
mount "${PART_ROOT}" /mnt
mkdir -p /mnt/boot
mount "${PART_EFI}" /mnt/boot

echo -e "\n${CYAN}▶ 3/5 Copiando imagem do vHackintosh OS para o disco (rsync)...${NC}"
rsync -aAXv --delete \
    --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found","/run/archiso/*"} \
    / /mnt/

# Diretórios virtuais no destino
mkdir -p /mnt/{dev,proc,sys,tmp,run,mnt,media}
chmod 1777 /mnt/tmp

echo -e "\n${CYAN}▶ 4/5 Gerando /etc/fstab e configurações de sistema...${NC}"
if command -v genfstab >/dev/null 2>&1; then
    genfstab -U /mnt > /mnt/etc/fstab
else
    EFI_UUID=$(blkid -s UUID -o value "${PART_EFI}")
    ROOT_UUID=$(blkid -s UUID -o value "${PART_ROOT}")
    cat <<EOF > /mnt/etc/fstab
UUID=${ROOT_UUID}   /       ${ROOT_FSTYPE}    rw,relatime,discard    0 1
UUID=${EFI_UUID}    /boot   vfat    rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro 0 2
EOF
    if [ -n "$PART_SWAP" ]; then
        SWAP_UUID=$(blkid -s UUID -o value "${PART_SWAP}" || true)
        if [ -n "$SWAP_UUID" ]; then
            echo "UUID=${SWAP_UUID}   none    swap    defaults    0 0" >> /mnt/etc/fstab
        fi
    fi
fi

# Hostname fixo para o Appliance
echo "vhackintosh-host" > /mnt/etc/hostname

# Limpa hooks de live boot no sistema instalado
rm -f /mnt/etc/mkinitcpio.conf.d/archiso.conf 2>/dev/null || true
rm -f /mnt/etc/systemd/system-generators/systemd-gpt-auto-generator 2>/dev/null || true

echo -e "\n${CYAN}▶ 5/5 Instalando Bootloader GRUB 2 UEFI e tema Dark Apple...${NC}"
mount --bind /dev /mnt/dev
mount --bind /proc /mnt/proc
mount --bind /sys /mnt/sys

chroot /mnt /bin/bash -c "
    # Cria o initramfs definitivo para o hardware real
    mkinitcpio -P

    # Instala o GRUB UEFI na partição de boot
    grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=vHackintosh --recheck

    # Aplica o tema personalizado do GRUB vHackintosh
    if [ -f /opt/vhackintosh/themes/grub/install.sh ]; then
        bash /opt/vhackintosh/themes/grub/install.sh || true
    fi

    # Gera a lista de boot do GRUB
    grub-mkconfig -o /boot/grub/grub.cfg

    # Habilita o gerenciador de conexões de rede
    systemctl enable NetworkManager.service 2>/dev/null || true
"

echo -e "\n${BLUE}▶ Sincronizando dados pendentes no disco...${NC}"
sync
umount -R /mnt 2>/dev/null || true

echo -e "\n${GREEN}======================================================================${NC}"
echo -e "${BOLD}${GREEN}        PARABÉNS! vHackintosh OS INSTALADO COM SUCESSO!               ${NC}"
echo -e "${GREEN}======================================================================${NC}\n"
echo -e "O seu computador agora está pronto para rodar macOS com aceleração nativa!"
echo -e "1. Remova o pendrive de instalação USB."
echo -e "2. Pressione ${BOLD}Enter${NC} para reiniciar o computador no vHackintosh OS."

read -rp ""
reboot
