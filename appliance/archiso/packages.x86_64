python-evdev

# LLVM tools (`llvm-dis`) e `spirv-val` continuam exigidos em RUNTIME pelo
# shader translator do reims-vgpu; mantemos as ferramentas sem os compiladores.
# O metal2vulkan executa `llvm-dis` para desmontar o AIR da Apple a cada shader
# ainda não cacheado, e o `vm/boot-x86.sh:require_shader_toolchain` aborta o
# boot se ele não estiver no PATH ("llvm-dis not found in PATH").
llvm
spirv-tools
