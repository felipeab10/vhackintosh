{
  "name": "vhackintosh-control-hud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test:a11y": "node --test scripts/a11y-layout-smoke.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "api:types": "uv run --with-requirements ../../web/requirements.lock -- python scripts/generate_api_types.py",
    "api:types:check": "uv run --with-requirements ../../web/requirements.lock -- python scripts/generate_api_types.py --check"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@fontsource/fira-code": "5.2.6",
    "@fontsource/inter": "5.2.6",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "6.1.2",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "typescript": "7.0.2",
    "uplot": "^1.6.32",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
